datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Cập nhật Enum Role: Chỉ còn ADMIN và SALE_ADMIN
enum Role {
  ADMIN       // Master Admin: Toàn quyền hệ thống + Quản lý User
  SALE_ADMIN  // Sale Admin: Toàn quyền Vận hành, Tính CBU, Duyệt & Xem Dashboard
}

enum OrderStatus {
  INQUIRY_RECEIVED          // 1. Khách gửi Yêu cầu (AI bóc)
  RFO_PENDING_ADMIN         // 2. Chờ Sale Admin / Admin kiểm tra & duyệt RFO
  RFO_SENT_TO_SUPPLIER      // 3. Đã gửi Hãng (Đang đợi Hãng trả Quote)
  SUPPLIER_QUOTED           // 4. Hãng đã báo giá (AI bóc PDF Quote)
  CBU_PENDING_ADMIN         // 5. Chờ Sale Admin / Admin nhập phí & chạy CBU
  QUOTATION_DRAFTED         // 6. Đã tính CBU & Sinh file PDF Quotation nháp
  QUOTED_TO_CLIENT          // 7. Đã duyệt & Phát hành Báo giá gửi Khách
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Password mã hóa bcrypt
  name      String
  role      Role     @default(SALE_ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreator")
}

model Client {
  id          String   @id @default(uuid())
  name        String
  companyName String
  email       String   @unique
  phone       String?
  address     String?
  rfqs        RFQ[]
}

model RFQ {
  id                String       @id @default(uuid())
  rfqCode           String       @unique // Ví dụ: RFO_PSBV_2026_001
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id])
  status            OrderStatus  @default(INQUIRY_RECEIVED)
  
  isProcessing      Boolean      @default(false)
  extractionError   String?      
  
  // Thông tin Hãng
  supplierQuoteCode String?      
  supplierName      String?
  supplierAddress   String?
  supplierPhone     String?
  supplierEmail     String?

  // Thông tin PO / MVPO
  poNumber          String?
  deliveryDate      DateTime?
  
  // Thông tin Cơ hội & Điều khoản
  opportunityName   String?      // Tên cơ hội kinh doanh (vd: "Gói thầu van VSP")
  paymentTerm       String?      // Điều khoản thanh toán (vd: "30 Days Net")
  incoTerm          String?      // Điều kiện giao hàng (vd: "DDP", "EXW")
  
  // B. Tỷ giá & làm tròn
  exchangeRate      Float        @default(26500)
  bookingExchangeRate Float?
  vndRoundingStep   Float?       @default(10000)
  lbToKg            Float?       @default(0.4536)
  currency          String?      @default("USD")

  // C. Điều kiện
  goodsOrigin       String?      @default("Oversea")
  destinationCountry String?     @default("VN")

  // D. Logistics
  freightCost       Float?       @default(0)
  freightFixed      Float?       @default(0)
  freightRatePerKg  Float?       @default(0)
  chargeableWeightKg Float?      @default(0)
  clearanceCost     Float?       @default(150)
  inlandCost        Float?       @default(100)
  docFee            Float?       @default(0)

  // E. Bảo hiểm
  insuredValuePercent Float?     @default(110)
  insuranceRatePercent Float?    @default(0.01)
  minInsuranceUsd   Float?       @default(15)

  // F. Phí ngân hàng
  remittanceRatePercent Float?   @default(0.2)
  bankVatFactor     Float?       @default(1.1)
  minRemittanceFeeUsd Float?     @default(50)
  receiveRatePercent Float?      @default(0.05)
  minReceiveFeeUsd  Float?       @default(5)
  receiveBaseUsd    Float?       @default(0)
  otherBankFeeUsd   Float?       @default(0)

  // G. Chi phí vốn
  percentValueFinanced Float?    @default(50)
  interestRatePercent Float?     @default(15)
  financingDays     Float?       @default(15)
  daysPerYear       Float?       @default(360)

  // Tài chính CBU (Calculated Results)
  totalCostUsd      Float?
  totalRevenueUsd   Float?
  totalRevenueVnd   BigInt?
  totalMarginUsd    Float?
  actualMarginPct   Float?
  
  // Custom Columns Config: Array of { id, name, type }
  customColumns     Json?
  
  // Người xử lý/Duyệt
  createdById       String?
  approvedById      String?
  
  items             RFQItem[]
  documents         Document[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model RFQItem {
  id                String   @id @default(uuid())
  rfqId             String
  rfq               RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineNo            Int
  
  rawPartNumber     String
  rawDescription    String?
  standardPartNo    String?  
  supplierDescription String?
  qty               Float    @default(1)
  uom               String   @default("PCS")
  supplier          String?
  
  netWeightLbs      Float?
  extWeightLbs      Float?
  supplierUnitPrice Float?   
  supplierExtPrice  Float?
  
  apportionedLogistics Float? @default(0)
  apportionedBank      Float? @default(0)
  apportionedInsurance Float? @default(0)
  dutyPercent       Float?   @default(0)
  dutyAmount        Float?   @default(0)
  commissionPercent Float?   @default(3)
  commissionAmount  Float?   @default(0)
  citPercent        Float?   @default(20)
  citAmount         Float?   @default(0)
  marginPercent     Float?   @default(25)
  
  unitCostUsd       Float?
  ddpPriceUsd       Float?
  ddpPriceVnd       BigInt?  
  marginPerUnitUsd  Float?
  
  // Values for custom columns: Record<string, number>
  customValues      Json?
}

model Document {
  id        String   @id @default(uuid())
  rfqId     String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  type      String   // 'INQUIRY_FILE', 'SUPPLIER_QUOTE_PDF', 'MVPO_QUOTATION_PDF'
  fileUrl   String
  createdAt DateTime @default(now())
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AiConfig {
  id             String   @id @default(uuid()) // Only one record usually
  name           String   @default("core")
  apiKey         String
  modelName      String   @default("gemini-1.5-pro")
  inquiryPrompt  String?  @db.Text
  quotePrompt    String?  @db.Text
  toolsConfig    String?  @db.Text
  resendApiKey   String?
  
  updatedAt      DateTime @updatedAt
}

model MasterPart {
  id          String   @id @default(uuid())
  partNumber  String   @unique
  description String
  uom         String   @default("PCS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  companyName   String
  email         String   @unique
  recipientName String?
  ccEmails      String?  
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
